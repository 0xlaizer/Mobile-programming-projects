<resources>
    <!-- Main button: pill shape, accent fill, dark text -->
    <style name="Widget.App.MainButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorAccent</item>
        <item name="android:textColor">@color/colorOnAccent</item>
        <item name="cornerRadius">50dp</item>
        <item name="android:paddingStart">40dp</item>
        <item name="android:paddingEnd">40dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">6dp</item>
    </style>

    <!-- Heading text -->
    <style name="Text.App.Heading" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Touch panel hint text -->
    <style name="Text.App.Hint" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/colorTextMuted</item>
    </style>
</resources>